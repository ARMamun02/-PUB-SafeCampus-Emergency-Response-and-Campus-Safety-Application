# Copy to .env and edit. Every value is optional.
PORT=3000
# Test mode: no real SMS or calls are ever made. Keep true until you are ready for a pilot.
TEST_MODE=true
# Shown as one-click demo logins on the sign-in screen. Set false in production.
DEMO_ACCOUNTS=true
# Leave empty to auto-generate a secret in data/.secret
JWT_SECRET=
# First admin created on first start (change the password!)
ADMIN_EMAIL=admin@safecampus.test
ADMIN_PASSWORD=admin1234
# Optional: where to POST SMS notifications when TEST_MODE=false (JSON: {to,text})
SMS_WEBHOOK_URL=
# Shared secret for the inbound SMS webhook (POST /api/sms/inbound)
SMS_INBOUND_SECRET=change-me
